# Copy to .env. Leave a key blank to keep that desk on the mock adapter.
# Caps are USD per calendar month in America/Chicago. They are estimates, not invoices.

XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

XAI_MONTHLY_CAP_USD=25
OPENAI_MONTHLY_CAP_USD=25
ANTHROPIC_MONTHLY_CAP_USD=25

XAI_MODEL=grok-3
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# sqlite file, or a postgres URL. Leave SQLITE_PATH blank for the OS temp dir
# (so next dev does not reload when the database writes). A path inside this
# repo will loop the dev server.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/cozy_ai_studio
DATABASE_URL=
SQLITE_PATH=

# Optional. When empty, distribution records a skip and sends nothing.
SOCIAL_WEBHOOK_URL=

# Not read yet. Muse and Higgsfield adapters are stubs until the contracts exist.
MUSE_API_BASE_URL=
MUSE_API_KEY=
HIGGSFIELD_API_BASE_URL=
HIGGSFIELD_API_KEY=

# Set to 1 to ignore live keys and force the mock desks (used by tests).
COZY_FORCE_MOCK=
